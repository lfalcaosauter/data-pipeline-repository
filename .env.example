# ============================================================
# APPLICATION
# ============================================================

APP_NAME=data-pipeline
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_oltp
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change_me


# ============================================================
# PGADMIN
# ============================================================

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050


# ============================================================
# DATA GENERATION
# ============================================================

FAKER_LOCALE=pt_BR
FAKER_SEED=42

NUM_AGENCIAS=10
NUM_CLIENTES=1000
NUM_CONTAS=1200
NUM_CARTOES=900
NUM_EMPRESTIMOS=400
NUM_TRANSACOES=10000


# ============================================================
# PIPELINE
# ============================================================

DATA_DIR=./data

BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold

FILE_FORMAT=parquet


# ============================================================
# PIPELINE EXECUTION
# ============================================================

BATCH_SIZE=1000

ENABLE_DATA_VALIDATION=true
FAIL_ON_DATA_QUALITY_ERROR=true


# ============================================================
# DATABASE CONNECTION POOL
# ============================================================

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=10